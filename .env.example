# Copy to .env and fill in. Never commit .env.

# Discord Developer Portal → your application → Bot → Reset Token
DISCORD_TOKEN=

# Discord server the bot runs in (slash commands are registered here)
GUILD_ID=1570304249047289937

# Neon → project → Connect → connection string (keep ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# https://challonge.com/settings/developer
CHALLONGE_USERNAME=
CHALLONGE_API_KEY=
